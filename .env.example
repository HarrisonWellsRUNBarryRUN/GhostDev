# GhostDev Environment Configuration
# Set SIMULATION_MODE=true to run offline demo loop without API keys
SIMULATION_MODE=true

# LLM Configuration (Used when SIMULATION_MODE=false)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o

# Optional: GitHub integration / Repository settings
GITHUB_TOKEN=your_github_token_here
REPO_PATH=.
